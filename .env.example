# Public URL of the deployed site, e.g. https://example.com (no trailing slash).
# Enables sitemap.xml, the canonical URL and absolute Open Graph image tags.
SITE_URL=https://jeyabalaji.vercel.app

# Origin of the contact API in server/ (no trailing slash), e.g. https://api.example.com.
# Leave empty to post to /api on the same origin; `npm run dev` proxies that to localhost:4000.
VITE_CONTACT_API_URL=
