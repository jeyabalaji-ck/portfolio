# Copy to .env and fill in. Never commit the real .env.

PORT=4000
NODE_ENV=development

# Comma-separated list of sites allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://jeyabalaji.vercel.app

# Number of proxies in front of the app (1 on Render, Railway, Fly, Heroku, Nginx).
# Needed so rate limiting sees the visitor's IP rather than the proxy's. 0 locally.
TRUST_PROXY=0

# SMTP credentials. For Gmail: enable 2-Step Verification, then create an
# App Password (https://myaccount.google.com/apppasswords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password

# MAIL_TO receives every enquiry (with the visitor's form details).
# MAIL_FROM sends both that email and the visitor's "message received" confirmation.
# Gmail requires MAIL_FROM to be SMTP_USER (or a verified alias). Leave it empty to use SMTP_USER.
MAIL_TO=you@gmail.com
MAIL_FROM=
MAIL_FROM_NAME=Portfolio Contact

# Signature and links used in the emails.
OWNER_NAME=Jeya Balaji C K
SITE_URL=https://jeyabalaji.vercel.app

# Email the visitor a confirmation that their message was received (true/false).
AUTO_REPLY=true

# Submissions allowed per IP address within the window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
